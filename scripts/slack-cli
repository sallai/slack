    chat_sub = chat.add_subparsers(required=True)

    post = chat_sub.add_parser("post", help="Post a message.")
    add_message_args(post)
    post.set_defaults(func=cmd_chat_post)

    ephemeral = chat_sub.add_parser("ephemeral", help="Post an ephemeral message.")
    add_message_args(ephemeral)
    ephemeral.add_argument("--user", required=True)
    ephemeral.set_defaults(func=cmd_chat_ephemeral)

    update = chat_sub.add_parser("update", help="Update a message.")
    update.add_argument("channel")
    update.add_argument("ts")
    add_content_args(update)
    update.add_argument("--blocks", help="JSON blocks, @file.json, or - for stdin.")
    update.set_defaults(func=cmd_chat_update)

    delete = chat_sub.add_parser("delete", help="Delete a message.")
    delete.add_argument("channel")
    delete.add_argument("ts")
    delete.set_defaults(func=cmd_chat_delete)

    schedule = chat_sub.add_parser("schedule", help="Schedule a message.")
    add_message_args(schedule)
    schedule.add_argument("--post-at", required=True, help="Unix timestamp when Slack should post the message.")
    schedule.set_defaults(func=cmd_chat_schedule)

    scheduled = chat_sub.add_parser("scheduled", help="List scheduled messages.")
    scheduled.add_argument("--channel")
    scheduled.add_argument("--limit", type=int, default=100)
    scheduled.set_defaults(func=cmd_chat_scheduled)

    unschedule = chat_sub.add_parser("unschedule", help="Delete a scheduled message.")
    unschedule.add_argument("channel")
    unschedule.add_argument("scheduled_message_id")
    unschedule.set_defaults(func=cmd_chat_unschedule)

    permalink = chat_sub.add_parser("permalink", help="Get a message permalink.")
    permalink.add_argument("channel")
    permalink.add_argument("ts")
    permalink.set_defaults(func=cmd_chat_permalink)


