def cmd_conversation_export(client: SlackClient, args: argparse.Namespace) -> int:
    latest = args.latest
    oldest = args.oldest or str(time.time() - args.days * 86400)
    output_dir = Path(args.output_dir).expanduser()
    files_dir = output_dir / "files"
    output_dir.mkdir(parents=True, exist_ok=True)
    if args.download_files:
        files_dir.mkdir(parents=True, exist_ok=True)

    channel_info = client.get("conversations.info", {"channel": args.channel}).get("channel", {})
    params = {
        "channel": args.channel,
        "oldest": oldest,
        "latest": latest,
        "inclusive": True,
    }
    messages = client.collect_cursor(
        "conversations.history",
        params,
        result_key="messages",
        limit=args.limit,
        http_method="POST",
    )
    messages = sorted(messages, key=lambda message: float(message.get("ts", "0")))

    if args.include_replies:
        for message in messages:
            if int(message.get("reply_count") or 0) <= 0:
                continue
            replies = client.collect_cursor(
                "conversations.replies",
                {"channel": args.channel, "ts": message["ts"], "oldest": oldest, "latest": latest, "inclusive": True},
                result_key="messages",
                http_method="POST",
            )
            message["replies"] = [
                reply for reply in sorted(replies, key=lambda item: float(item.get("ts", "0"))) if reply.get("ts") != message.get("ts")
            ]

    files = extract_message_files(messages)
    if args.download_files:
        for file_info in files:
            url = file_info.get("url_private_download") or file_info.get("url_private")
            if not url:
                file_info["_download_error"] = "No private download URL available."
                continue
            filename = safe_file_name(file_info.get("name") or file_info.get("title") or file_info.get("id") or "slack-file")
            output_path = files_dir / f"{safe_file_name(file_info.get('_message_ts', 'unknown'))}_{file_info.get('id', 'file')}_{filename}"
            try:
                download_private_url(client, url, output_path)
                file_info["_download_path"] = str(output_path)
            except SlackError as error:
                file_info["_download_error"] = str(error)

    user_names = build_user_name_map(client, messages)
    export_data = {
        "channel": channel_info,
        "oldest": oldest,
        "oldest_datetime": slack_ts_to_local(oldest),
        "latest": latest,
        "latest_datetime": slack_ts_to_local(latest) if latest else "Slack API default: now",
        "message_count": count_messages(messages, include_replies=True),
        "parent_message_count": len(messages),
        "file_count": len(files),
        "messages": messages,
        "files": files,
    }

    (output_dir / "history.json").write_text(json.dumps(export_data, indent=2, ensure_ascii=False), encoding="utf-8")
    (output_dir / "files.json").write_text(json.dumps(files, indent=2, ensure_ascii=False), encoding="utf-8")
    (output_dir / "messages.md").write_text(render_messages_markdown(channel_info, messages, user_names, files), encoding="utf-8")
    print(f"Wrote {output_dir / 'history.json'}", file=sys.stderr, flush=True)
    print(f"Wrote {output_dir / 'messages.md'}", file=sys.stderr, flush=True)
    print(f"Wrote {output_dir / 'files.json'}", file=sys.stderr, flush=True)
    if args.download_files:
        print(f"Wrote downloads under {files_dir}", file=sys.stderr, flush=True)
    if OUTPUT_FORMAT == "json":
        emit_json(
            {
                "output_dir": str(output_dir),
                "written": {
                    "history": str(output_dir / "history.json"),
                    "messages": str(output_dir / "messages.md"),
                    "files": str(output_dir / "files.json"),
                    "downloads_dir": str(files_dir) if args.download_files else None,
                },
                "message_count": export_data["message_count"],
                "parent_message_count": export_data["parent_message_count"],
                "file_count": export_data["file_count"],
            }
        )
    return 0


