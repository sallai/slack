class SlackError(RuntimeError):
    def __init__(self, method: str, message: str, response: dict[str, Any] | None = None) -> None:
        self.method = method
        self.response = response or {}
        super().__init__(f"Slack API {method}: {message}")


class SlackClient:
    def __init__(self, token: str) -> None:
        self.token = token

    def get(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        return self.request(method, params=params, http_method="GET")

    def post(self, method: str, body: dict[str, Any] | None = None, form: bool = False) -> dict[str, Any]:
        return self.request(method, params=body, http_method="POST", form=form)

    def request(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        http_method: str = "POST",
        form: bool = False,
    ) -> dict[str, Any]:
        method = normalize_method(method)
        params = clean_params(params or {})
        url = f"{API_BASE}/{method}"
        data = None
        headers = {"Authorization": f"Bearer {self.token}"}

        if http_method == "GET":
            if params:
                url = f"{url}?{urllib.parse.urlencode(params, doseq=True)}"
        elif form:
            data = urllib.parse.urlencode(params, doseq=True).encode("utf-8")
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        else:
            data = json.dumps(params).encode("utf-8")
            headers["Content-Type"] = "application/json; charset=utf-8"

        request = urllib.request.Request(url, data=data, method=http_method, headers=headers)
        try:
            with urllib.request.urlopen(request) as response:
                payload = response.read().decode("utf-8")
        except urllib.error.HTTPError as error:
            if error.code == 429:
                retry_after = error.headers.get("Retry-After")
                if retry_after and retry_after.isdigit():
                    time.sleep(int(retry_after))
                    return self.request(method, params=params, http_method=http_method, form=form)

            payload = error.read().decode("utf-8", errors="replace")
            raise SlackError(method, f"HTTP {error.code} {error.reason}: {payload}") from error

        try:
            parsed = json.loads(payload) if payload else {}
        except json.JSONDecodeError as error:
            raise SlackError(method, f"non-JSON response: {payload}") from error

        if parsed.get("ok") is False:
            message = parsed.get("error", "ok_false")
            needed = parsed.get("needed")
            provided = parsed.get("provided")
            if needed:
                message = f"{message}; needed={needed}; provided={provided}"
            raise SlackError(method, message, parsed)

        return parsed

    def collect_cursor(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        result_key: str | None = None,
        limit: int | None = None,
        http_method: str = "GET",
    ) -> list[Any]:
        params = dict(params or {})
        results: list[Any] = []
        cursor = params.get("cursor")

        while True:
            remaining = None if limit is None else max(1, limit - len(results))
            params["limit"] = min(200, remaining) if remaining is not None else params.get("limit", 200)
            if cursor:
                params["cursor"] = cursor
            else:
                params.pop("cursor", None)

            page = self.get(method, params) if http_method == "GET" else self.post(method, params)
            key = result_key or first_list_key(page)
            if key:
                results.extend(page.get(key, []))
            else:
                results.append(page)

            if limit is not None and len(results) >= limit:
                return results[:limit]

            cursor = (page.get("response_metadata") or {}).get("next_cursor")
            if not cursor:
                return results


def main() -> int:
    global OUTPUT_FORMAT, STARTED_AT
    STARTED_AT = time.perf_counter()
    args = build_parser().parse_args()
    OUTPUT_FORMAT = args.output

    try:
        if args.schema:
            emit_json(build_schema())
            return 0
        if not hasattr(args, "func"):
            build_parser().print_usage(sys.stderr)
            return EXIT_USAGE
        if not getattr(args, "requires_auth", True):
            return args.func(None, args)

        load_env_files([Path(path).expanduser() for path in args.env_file] if args.env_file else SLACK_ENV_FILES)
        token = os.environ.get("SLACK_BOT_TOKEN") or os.environ.get("SLACK_USER_TOKEN") or os.environ.get("SLACK_TOKEN")
        if not token:
            return emit_error("missing_credentials", "Slack credentials are not configured.", EXIT_AUTH, setup_text=build_slack_setup_text())

        client = SlackClient(token)
        return args.func(client, args)
    except (SlackError, RuntimeError, ValueError, OSError, json.JSONDecodeError) as error:
        if isinstance(error, SlackError) and is_auth_setup_error(error):
            return emit_error(slack_error_code(error), str(error), slack_error_exit_code(error), setup_text=build_slack_setup_text())
        return emit_error("runtime_error", str(error), EXIT_RUNTIME)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="slack-cli",
        description=(
            "Single-file Slack Web API CLI using ~/.slack/env credentials. "
            "Exit codes: 0 success, 1 runtime/API, 2 usage, 3 auth, 4 permission, 5 domain."
        ),
    )
    parser.add_argument(
        "--env-file",
        action="append",
        help="Credential env file to load. Defaults to ~/.slack/env and compatible fallbacks.",
    )
    parser.add_argument("--output", choices=["human", "json"], default="human", help="Output format. JSON mode emits one envelope object.")
    parser.add_argument("--schema", action="store_true", help="Print machine-readable command schema as JSON.")
    subparsers = parser.add_subparsers()

    add_setup_parser(subparsers)
    add_me_parser(subparsers)
    add_api_parser(subparsers)
    add_schema_parser(subparsers)
    add_conversation_parser(subparsers)
    add_chat_parser(subparsers)
    add_search_parser(subparsers)
    add_user_parser(subparsers)
    add_file_parser(subparsers)
    add_reaction_parser(subparsers)
    add_pin_parser(subparsers)
    add_bookmark_parser(subparsers)
    add_team_parser(subparsers)
    add_emoji_parser(subparsers)

    return parser


def add_setup_parser(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("setup", help="Print user-token OAuth setup instructions and an app manifest.")
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--manifest-only", action="store_true", help="Print only the Slack App Manifest YAML.")
    output.add_argument("--env-only", action="store_true", help="Print only the local credential-file instructions.")
    parser.set_defaults(func=cmd_setup, requires_auth=False)


def add_me_parser(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("me", help="Run auth.test for the active token.")
    parser.set_defaults(func=cmd_me)


def add_api_parser(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("api", help="Call any Slack Web API method.")
    parser.add_argument("http_method", choices=["GET", "POST"])
    parser.add_argument("method", help="Slack method such as auth.test, or /api/auth.test.")
    parser.add_argument("--data", help="JSON request body, @file.json, or - for stdin.")
    parser.add_argument("--param", action="append", default=[], help="Add a scalar parameter as key=value.")
    parser.add_argument("--form", action="store_true", help="POST as x-www-form-urlencoded instead of JSON.")
    parser.add_argument("--paginate", action="store_true", help="Collect cursor-paginated results.")
    parser.add_argument("--result-key", help="Result list key for pagination, e.g. channels, messages, files.")
    parser.add_argument("--limit", type=int, help="Maximum total paginated results.")
    parser.set_defaults(func=cmd_api)


def add_schema_parser(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("schema", help="Print machine-readable command schema.")
    parser.set_defaults(func=cmd_schema, requires_auth=False)


