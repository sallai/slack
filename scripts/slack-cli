def cmd_file_upload(client: SlackClient, args: argparse.Namespace) -> int:
    path = Path(args.path).expanduser()
    data = path.read_bytes()
    filename = path.name

    ticket = client.get(
        "files.getUploadURLExternal",
        {
            "filename": filename,
            "length": len(data),
            "alt_txt": args.alt_txt,
            "snippet_type": args.snippet_type,
        },
    )
    upload_url = ticket["upload_url"]
    file_id = ticket["file_id"]
    upload_file_bytes(upload_url, filename, data)

    complete_body: dict[str, Any] = {
        "files": [{"id": file_id, "title": args.title or filename}],
        "channel_id": args.channel,
        "channels": args.channels,
        "initial_comment": args.initial_comment,
        "thread_ts": args.thread_ts,
    }
    emit_json(client.post("files.completeUploadExternal", complete_body))
    return 0


def cmd_file_download(client: SlackClient, args: argparse.Namespace) -> int:
    request = urllib.request.Request(args.url, headers={"Authorization": f"Bearer {client.token}"})
    try:
        with urllib.request.urlopen(request) as response:
            Path(args.output).expanduser().write_bytes(response.read())
    except urllib.error.HTTPError as error:
        raise SlackError("file.download", f"HTTP {error.code} {error.reason}") from error
    print(f"Wrote {args.output}", file=sys.stderr, flush=True)
    if OUTPUT_FORMAT == "json":
        emit_json({"output": str(Path(args.output).expanduser())})
    return 0


