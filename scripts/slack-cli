def normalize_method(method: str) -> str:
    method = method.strip()
    if method.startswith(API_BASE):
        method = method[len(API_BASE) :]
    if method.startswith("/api/"):
        method = method[len("/api/") :]
    return method.lstrip("/")


def clean_params(params: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in params.items() if value is not None}


def first_list_key(response: dict[str, Any]) -> str | None:
    skip = {"ok", "response_metadata", "warning", "needed", "provided"}
    for key, value in response.items():
        if key not in skip and isinstance(value, list):
            return key
    return None


def load_env_files(paths: list[Path]) -> None:
    for path in paths:
        if path.exists():
            load_env_file(path)


def load_env_file(path: Path) -> None:
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].strip()

        key, separator, value = line.partition("=")
        if not separator:
            continue
        key = key.strip()
        if key and key not in os.environ:
            os.environ[key] = strip_env_quotes(value.strip())


def strip_env_quotes(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def build_slack_setup_text() -> str:
    return f"""Slack access is not set up for slack-cli.

This CLI is designed to use a Slack user OAuth token when it should act as you.
Slack App Manifests can declare the OAuth scopes up front, so you do not need to
click each scope manually. Slack still requires an OAuth approval/install step
before it will issue an xoxp user token.

1. Create or update a Slack app from this manifest:

```yaml
{SLACK_USER_APP_MANIFEST_YAML.rstrip()}
```

Use one of these setup paths:

- UI path: open https://api.slack.com/apps, choose "Create New App", then
  "From an app manifest", and paste the YAML above.
- API path: generate a short-lived configuration token from the Slack app
  settings page, then use Slack's apps.manifest.create or apps.manifest.update
  API with the YAML above.

2. Configure OAuth:

- In the app's Basic Information page, copy the Client ID.
- Keep or replace the manifest redirect URL with a redirect URL you control.
- Start OAuth with a URL shaped like this, replacing CLIENT_ID and REDIRECT_URI:

https://slack.com/oauth/v2/authorize?client_id=CLIENT_ID&user_scope={slack_user_scope_csv()}&redirect_uri=REDIRECT_URI

3. Finish OAuth:

- Approve the requested user scopes as the Slack user the CLI should act as.
- Exchange the returned code for a token with oauth.v2.access if you are
  running your own callback handler, or copy the resulting User OAuth Token
  from the Slack app settings after installation.
- The token should start with xoxp-.

{build_slack_env_setup_text().rstrip()}

Reference docs:
- App manifests: https://docs.slack.dev/app-manifests/
- Manifest reference: https://docs.slack.dev/reference/app-manifest
- Manifest APIs: https://docs.slack.dev/reference/methods/apps.manifest.create/
- OAuth v2: https://docs.slack.dev/authentication/installing-with-oauth
- Slack token types: https://docs.slack.dev/authentication/tokens/
"""


def build_slack_env_setup_text() -> str:
    return """4. Store the token outside this repository:

```sh
mkdir -p ~/.slack
chmod 700 ~/.slack
$EDITOR ~/.slack/env
chmod 600 ~/.slack/env
```

Put this in ~/.slack/env:

```sh
SLACK_USER_TOKEN=xoxp-your-user-token-here
```

Then verify access:

```sh
uv run scripts/slack-cli me
```
"""


def slack_user_scope_csv() -> str:
    scopes = []
    in_user_scope = False
    for line in SLACK_USER_APP_MANIFEST_YAML.splitlines():
        stripped = line.strip()
        if stripped == "user:":
            in_user_scope = True
            continue
        if in_user_scope:
            if not stripped:
                continue
            if not stripped.startswith("- "):
                break
            scopes.append(stripped[2:])
    return ",".join(scopes)


def is_auth_setup_error(error: SlackError) -> bool:
    slack_error = error.response.get("error")
    return isinstance(slack_error, str) and slack_error in AUTH_SETUP_ERRORS


def read_json_arg(value: str) -> Any:
    if value == "-":
        return json.loads(sys.stdin.read())
    if value.startswith("@"):
        return json.loads(Path(value[1:]).expanduser().read_text(encoding="utf-8"))
    return json.loads(value)


def read_text_arg(args: argparse.Namespace) -> str:
    if getattr(args, "text_file", None):
        return Path(args.text_file).expanduser().read_text(encoding="utf-8")
    return args.text


def parse_pairs(pairs: list[str]) -> dict[str, str]:
    parsed = {}
    for pair in pairs:
        key, separator, value = pair.partition("=")
        if not separator:
            raise ValueError(f"Invalid parameter {pair!r}; expected key=value.")
        parsed[key] = value
    return parsed


def message_body(args: argparse.Namespace) -> dict[str, Any]:
    body: dict[str, Any] = {"channel": args.channel, "text": read_text_arg(args)}
    if args.thread_ts:
        body["thread_ts"] = args.thread_ts
    if args.reply_broadcast:
        body["reply_broadcast"] = True
    if args.blocks:
        body["blocks"] = read_json_arg(args.blocks)
    if args.unfurl_links:
        body["unfurl_links"] = args.unfurl_links == "true"
    if args.unfurl_media:
        body["unfurl_media"] = args.unfurl_media == "true"
    return body


def extract_message_files(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
    files: list[dict[str, Any]] = []
    for message in messages:
        append_files_from_message(files, message)
        for reply in message.get("replies", []):
            append_files_from_message(files, reply)
    return files


def append_files_from_message(files: list[dict[str, Any]], message: dict[str, Any]) -> None:
    for file_info in message.get("files", []) or []:
        if not isinstance(file_info, dict):
            continue
        item = dict(file_info)
        item["_message_ts"] = message.get("ts")
        item["_thread_ts"] = message.get("thread_ts")
        files.append(item)


def build_user_name_map(client: SlackClient, messages: list[dict[str, Any]]) -> dict[str, str]:
    users = sorted(collect_user_ids(messages))
    names: dict[str, str] = {}
    for user_id in users:
        try:
            user = client.get("users.info", {"user": user_id}).get("user", {})
            profile = user.get("profile", {}) or {}
            names[user_id] = (
                profile.get("display_name")
                or profile.get("real_name")
                or user.get("real_name")
                or user.get("name")
                or user_id
            )
        except SlackError:
            names[user_id] = user_id
    return names


def collect_user_ids(messages: list[dict[str, Any]]) -> set[str]:
    users: set[str] = set()
    for message in messages:
        append_user_id(users, message)
        for reply in message.get("replies", []):
            append_user_id(users, reply)
    return users


def append_user_id(users: set[str], message: dict[str, Any]) -> None:
    user = message.get("user")
    if isinstance(user, str) and user:
        users.add(user)


def count_messages(messages: list[dict[str, Any]], include_replies: bool = False) -> int:
    total = len(messages)
    if include_replies:
        total += sum(len(message.get("replies", [])) for message in messages)
    return total


def render_messages_markdown(
    channel: dict[str, Any],
    messages: list[dict[str, Any]],
    user_names: dict[str, str],
    files: list[dict[str, Any]],
) -> str:
    name = channel.get("name") or channel.get("id") or "conversation"
    lines = [f"# Slack export: #{name}", ""]
    files_by_message: dict[str, list[dict[str, Any]]] = {}
    for file_info in files:
        files_by_message.setdefault(file_info.get("_message_ts", ""), []).append(file_info)

    for message in messages:
        lines.extend(render_one_message(message, user_names, files_by_message))
        for reply in message.get("replies", []):
            lines.extend(render_one_message(reply, user_names, files_by_message, indent="  "))
    return "\n".join(lines).rstrip() + "\n"


def render_one_message(
    message: dict[str, Any],
    user_names: dict[str, str],
    files_by_message: dict[str, list[dict[str, Any]]],
    indent: str = "",
) -> list[str]:
    ts = message.get("ts", "")
    user = user_names.get(message.get("user", ""), message.get("username") or message.get("user") or message.get("bot_id") or "unknown")
    text = normalize_slack_text(message.get("text") or "")
    prefix = f"{indent}- **{slack_ts_to_local(ts)}** — **{user}**"
    lines = [prefix]
    if text:
        for line in text.splitlines():
            lines.append(f"{indent}  {line}")

    for attachment in message.get("attachments", []) or []:
        fallback = attachment.get("fallback") or attachment.get("title") or attachment.get("text")
        if fallback:
            lines.append(f"{indent}  Attachment: {fallback}")

    for file_info in files_by_message.get(ts, []):
        title = file_info.get("title") or file_info.get("name") or file_info.get("id") or "file"
        mimetype = file_info.get("mimetype") or file_info.get("filetype") or "file"
        path = file_info.get("_download_path")
        if path:
            lines.append(f"{indent}  File: [{title}]({path}) ({mimetype})")
        else:
            lines.append(f"{indent}  File: {title} ({mimetype})")
    return lines + [""]


def normalize_slack_text(text: str) -> str:
    text = re.sub(r"<(https?://[^>|]+)\|([^>]+)>", r"[\2](\1)", text)
    text = re.sub(r"<(https?://[^>]+)>", r"\1", text)
    text = re.sub(r"<@([A-Z0-9]+)>", r"@\1", text)
    text = re.sub(r"<#([A-Z0-9]+)\|([^>]+)>", r"#\2", text)
    return text


def slack_ts_to_local(ts: str | float | int) -> str:
    try:
        timestamp = float(ts)
    except (TypeError, ValueError):
        return str(ts)
    value = dt.datetime.fromtimestamp(timestamp).astimezone()
    return value.strftime("%Y-%m-%d %H:%M:%S %Z")


def safe_file_name(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", value)
    return cleaned.strip("._") or "file"


def emit_json(value: Any) -> None:
    if OUTPUT_FORMAT == "json":
        payload = {
            "status": "success",
            "metadata": {"execution_time_ms": elapsed_ms(), "records_processed": count_records(value)},
            "data": value,
        }
        print(json.dumps(payload, indent=2, ensure_ascii=False), flush=True)
    else:
        print(json.dumps(value, indent=2, ensure_ascii=False), flush=True)


def emit_error(code: str, message: str, exit_code: int, *, retryable: bool = False, setup_text: str | None = None) -> int:
    if setup_text:
        print(setup_text, file=sys.stderr, flush=True)
    if OUTPUT_FORMAT == "json":
        payload = {
            "status": "error",
            "metadata": {"execution_time_ms": elapsed_ms()},
            "error": {"code": code, "message": message, "retryable": retryable},
        }
        print(json.dumps(payload, indent=2, ensure_ascii=False), flush=True)
    else:
        print(message, file=sys.stderr, flush=True)
    return exit_code


def elapsed_ms() -> int:
    return int((time.perf_counter() - STARTED_AT) * 1000)


def count_records(value: Any) -> int:
    if isinstance(value, list):
        return len(value)
    if isinstance(value, dict):
        for key in ("channels", "messages", "files", "members", "items", "scheduled_messages", "data"):
            item = value.get(key)
            if isinstance(item, list):
                return len(item)
        return 1
    return 1 if value is not None else 0


def slack_error_code(error: SlackError) -> str:
    response_error = error.response.get("error")
    return str(response_error or "auth_error")


def slack_error_exit_code(error: SlackError) -> int:
    code = slack_error_code(error)
    if code == "missing_scope":
        return EXIT_PERMISSION
    return EXIT_AUTH


def build_schema() -> dict[str, Any]:
    return {
        "tool": "slack-cli",
        "output": {
            "formats": ["human", "json"],
            "default": "human",
            "json_envelope": {"status": "success|error", "metadata": "object", "data": "any", "error": "object"},
        },
        "credentials": {
            "env_files": [str(path) for path in SLACK_ENV_FILES],
            "token_env_vars": ["SLACK_BOT_TOKEN", "SLACK_USER_TOKEN", "SLACK_TOKEN"],
        },
        "exit_codes": {
            "0": "success",
            "1": "runtime/API/network/fatal error",
            "2": "CLI syntax or argument error",
            "3": "missing or invalid credentials",
            "4": "permission denied or missing scopes",
            "5": "validation, not found, conflict, or domain-specific failure",
        },
        "commands": {
            "setup": {"auth": False, "args": ["--manifest-only", "--env-only"]},
            "me": {"auth": True},
            "api": {"auth": True, "args": ["http_method", "method", "--data", "--param", "--form", "--paginate", "--result-key", "--limit"]},
            "conversation": {"auth": True, "aliases": ["conversations", "channel"], "subcommands": ["list", "info", "history", "replies", "members", "create", "join", "leave", "invite", "kick", "open", "archive", "unarchive", "rename", "topic", "purpose", "export"]},
            "chat": {"auth": True, "subcommands": ["post", "ephemeral", "update", "delete", "schedule", "scheduled", "unschedule", "permalink"]},
            "search": {"auth": True, "subcommands": ["messages", "files"]},
            "user": {"auth": True, "aliases": ["users"], "subcommands": ["list", "info", "lookup-email"]},
            "file": {"auth": True, "aliases": ["files"], "subcommands": ["list", "info", "upload", "download", "delete"]},
            "reaction": {"auth": True, "aliases": ["reactions"], "subcommands": ["add", "remove", "get"]},
            "pin": {"auth": True, "aliases": ["pins"], "subcommands": ["add", "remove", "list"]},
            "bookmark": {"auth": True, "aliases": ["bookmarks"], "subcommands": ["list", "add", "edit", "remove"]},
            "team": {"auth": True, "subcommands": ["info"]},
            "emoji": {"auth": True, "subcommands": ["list"]},
        },
    }


def upload_file_bytes(upload_url: str, filename: str, data: bytes) -> None:
    content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
    request = urllib.request.Request(
        upload_url,
        data=data,
        method="POST",
        headers={"Content-Type": content_type, "Content-Length": str(len(data))},
    )
    try:
        with urllib.request.urlopen(request) as response:
            response.read()
    except urllib.error.HTTPError as error:
        payload = error.read().decode("utf-8", errors="replace")
        raise SlackError("files.uploadBytes", f"HTTP {error.code} {error.reason}: {payload}") from error


def download_private_url(client: SlackClient, url: str, output_path: Path) -> None:
    output_path.parent.mkdir(parents=True, exist_ok=True)
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {client.token}"})
    try:
        with urllib.request.urlopen(request) as response:
            output_path.write_bytes(response.read())
    except urllib.error.HTTPError as error:
        payload = error.read().decode("utf-8", errors="replace")
        raise SlackError("file.download", f"HTTP {error.code} {error.reason}: {payload}") from error


if __name__ == "__main__":
    raise SystemExit(main())
