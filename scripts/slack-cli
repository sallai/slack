    group.add_argument("--text")
    group.add_argument("--text-file")


def add_message_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("channel")
    add_content_args(parser)
    parser.add_argument("--thread-ts")
    parser.add_argument("--reply-broadcast", action="store_true")
    parser.add_argument("--blocks", help="JSON blocks, @file.json, or - for stdin.")
    parser.add_argument("--unfurl-links", choices=["true", "false"])
    parser.add_argument("--unfurl-media", choices=["true", "false"])


def cmd_setup(_client: SlackClient | None, args: argparse.Namespace) -> int:
    if args.manifest_only:
        text = SLACK_USER_APP_MANIFEST_YAML.rstrip()
    elif args.env_only:
        text = build_slack_env_setup_text().rstrip()
    else:
        text = build_slack_setup_text().rstrip()
    if OUTPUT_FORMAT == "json":
        emit_json({"text": text})
    else:
        print(text, flush=True)
    return 0


def cmd_me(client: SlackClient, _args: argparse.Namespace) -> int:
    emit_json(client.post("auth.test"))
    return 0


def cmd_api(client: SlackClient, args: argparse.Namespace) -> int:
    params = read_json_arg(args.data) if args.data else {}
    if not isinstance(params, dict):
        raise ValueError("--data must decode to a JSON object.")
    params.update(parse_pairs(args.param))

    if args.paginate:
        emit_json(
            client.collect_cursor(
                args.method,
                params,
                result_key=args.result_key,
                limit=args.limit,
                http_method=args.http_method,
            )
        )
    else:
        emit_json(client.request(args.method, params, http_method=args.http_method, form=args.form))
    return 0


def cmd_schema(_client: SlackClient | None, _args: argparse.Namespace) -> int:
    emit_json(build_schema())
    return 0


